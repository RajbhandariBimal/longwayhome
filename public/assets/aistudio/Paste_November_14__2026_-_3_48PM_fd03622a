      id: d.id,
      pin: d.pin,
      order: d.order,
      title: d.title,
      sector: d.sector,
      targetX: d.tx,
      targetY: d.ty,
      walkX: d.wx,
      walkY: d.wy,
      completed: d.completed,
      lockedReason: d.lockedReason,
      instructions: d.instructions,
      controlsCue: d.controlsCue,
      reward: d.reward,
      bearing: getCompassBearing(dx, dy),
      distanceMeters: Math.max(0, Math.round(distPx / 2)),
    };
  });
}

export function resolveActiveObjective(
  objectives: NavigationObjective[],
  manualTrackedId: ObjectivePinId | null
): NavigationObjective {
  if (manualTrackedId) {
    const found = objectives.find((o) => o.id === manualTrackedId);
    if (found) return found;
  }
  const nextStory = objectives.find((o) => o.order <= 6 && !o.completed);
  if (nextStory) return nextStory;
  const nextExtra = objectives.find((o) => !o.completed);
  return nextExtra ?? objectives[objectives.length - 1];
}
