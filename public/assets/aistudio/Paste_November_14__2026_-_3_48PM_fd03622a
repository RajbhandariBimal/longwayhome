  if (!ctx) return;

  ctx.imageSmoothingEnabled = false;

  // 1. Mars Terrain Base
  for (let ty = 0; ty < MAP_H; ty++) {
    for (let tx = 0; tx < MAP_W; tx++) {
      const t = tiles[ty][tx];
      ctx.fillStyle =
        t === 'mountain_wall'
          ? '#3d1712'
          : t === 'ridge_rock'
          ? '#75311c'
          : t === 'crater_floor'
          ? '#6b2c17'
          : t === 'crater_rim'
          ? '#b95f3a'
          : t === 'scorch'
          ? '#4a1f14'
          : '#8e3d21';
      ctx.fillRect(
        Math.floor(tx * MINI_SCALE),
        Math.floor(ty * MINI_SCALE),
        Math.ceil(MINI_SCALE),
        Math.ceil(MINI_SCALE)
      );
    }
  }

  // 2. Crash Site Safety Ring
  const rcx = (CRASH_SITE_POS.tx + CRASH_SITE_POS.w / 2) * MINI_SCALE;
  const rcy = (CRASH_SITE_POS.ty + CRASH_SITE_POS.h / 2) * MINI_SCALE;
  const safeR = (CRASH_SAFE_RADIUS_PX / TILE_SIZE) * MINI_SCALE;
  ctx.save();
  ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';
  ctx.lineWidth = 1;
  ctx.setLineDash([2, 2]);
  ctx.beginPath();
  ctx.arc(rcx, rcy, safeR, 0, Math.PI * 2);
  ctx.stroke();
  ctx.restore();

  // 3. Salvage Dots
  for (const s of structures) {
    if (s.category !== 'exploration_site') continue;
    const sx = (s.tx + s.w / 2) * MINI_SCALE;
    const sy = (s.ty + s.h / 2) * MINI_SCALE;
    ctx.fillStyle = s.salvaged ? 'rgba(148, 163, 184, 0.45)' : '#fb923c';
    ctx.fillRect(Math.round(sx - 1), Math.round(sy - 1), 3, 3);
  }

  // 4. Opportunity Scanner Trail
  if (stats.story.scannerTrailActive) {
    ctx.save();
    ctx.strokeStyle = '#38bdf8';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([2, 2]);
    ctx.beginPath();
    SCANNER_TRAIL_POINTS.forEach((pt, idx) => {
      const mx = (pt.x / TILE_SIZE) * MINI_SCALE;
      const my = (pt.y / TILE_SIZE) * MINI_SCALE;
      if (idx === 0) ctx.moveTo(mx, my);
      else ctx.lineTo(mx, my);
