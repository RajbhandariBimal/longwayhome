        x: (ROVER_TRACKS_TILE.tx + 1) * TILE_SIZE,
        y: (ROVER_TRACKS_TILE.ty + 0.5) * TILE_SIZE,
        wx: (ROVER_TRACKS_TILE.tx + 0.5) * TILE_SIZE,
        wy: (ROVER_TRACKS_TILE.ty + 0.5) * TILE_SIZE,
