      tx: 28 * TILE_SIZE,
      ty: 19 * TILE_SIZE,
      wx: 28.5 * TILE_SIZE,
      wy: 21.8 * TILE_SIZE,
      completed: story.jetpackUnlocked,
      instructions:
        'Interact with the Crashed Spacecraft (Ares IV) in the center of the map and click "Escape Wreck" to auto-run past burning debris and collect 10 Jetpack Fuel Cells.',
      controlsCue: 'Press E at Spacecraft · Space/Click to Jump',
      reward: 'EVA Jetpack',
    },
    {
      id: 'battery_rush',
      pin: '2',
      order: 2,
      title: 'Battery Rush',
      sector: 'Northern Solar Ridge',
      tx: 18.5 * TILE_SIZE,
      ty: 6 * TILE_SIZE,
      wx: 18.5 * TILE_SIZE,
      wy: 8 * TILE_SIZE,
      completed: story.powerCouplerRecovered,
      instructions:
        'Head northwest to Outpost 02 at the Solar Ridge Power Grid. Use blue jump pads and your Jetpack, dodge pulsing and moving electric bars, and collect 10 batteries before the 01:30 timer runs out.',
      controlsCue: 'Press E at Solar Grid · A/D + Space (01:30)',
      reward: 'Power Coupler',
    },
    {
      id: 'canyon_run',
