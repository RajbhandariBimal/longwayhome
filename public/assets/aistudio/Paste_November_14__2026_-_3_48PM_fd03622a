import { OPPORTUNITY_TILE, ROVER_TRACKS_TILE, TILE_SIZE } from './mapData';
import { PlayerState, SurvivalStats } from './types';

export type ObjectivePinId =
  | 'escape_wreck'
  | 'battery_rush'
  | 'canyon_run'
  | 'opportunity_explorer'
  | 'dust_devil_chase'
  | 'systems_repair'
  | 'rover_recovery'
  | 'crashed_rocket';

export interface NavigationObjective {
  id: ObjectivePinId;
  pin: string;
  order: number;
  title: string;
  sector: string;
  targetX: number;
  targetY: number;
  walkX: number;
  walkY: number;
  completed: boolean;
  lockedReason?: string;
  instructions: string;
  controlsCue: string;
  reward: string;
  bearing: string;
  distanceMeters: number;
}

export function getCompassBearing(dx: number, dy: number): string {
  const angle = Math.atan2(dy, dx); // radians, 0 = East, -PI/2 = North
  const deg = ((angle * 180) / Math.PI + 360) % 360;
  if (deg >= 337.5 || deg < 22.5) return 'E';
  if (deg < 67.5) return 'SE';
  if (deg < 112.5) return 'S';
  if (deg < 157.5) return 'SW';
  if (deg < 202.5) return 'W';
  if (deg < 247.5) return 'NW';
  if (deg < 292.5) return 'N';
  return 'NE';
}

export function buildNavigationObjectives(
  stats: SurvivalStats,
  player: PlayerState
): NavigationObjective[] {
  const { story, pathfinderMission, rocket } = stats;
  const shipDone =
    rocket.hull >= 100 &&
    rocket.engines >= 100 &&
    rocket.avionics >= 100 &&
    rocket.powerCore >= 100 &&
